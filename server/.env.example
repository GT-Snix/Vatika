# Postgres connection, e.g. postgresql://postgres:postgres@localhost:5432/vatika for local Docker.
DATABASE_URL=
# Long random string used to sign JWTs.
JWT_SECRET=
PORT=4000
# Origin of the Vite dev server, for CORS.
CLIENT_ORIGIN=http://localhost:5173
# 1 = real time; 60 = one real minute counts as one game hour, for demos
TIME_SCALE=1
