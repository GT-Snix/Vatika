# Supabase pooled connection (port 6543, add ?pgbouncer=true). Used by the app at runtime.
DATABASE_URL=
# Supabase direct connection (port 5432). Used by `prisma migrate`, which can't run through PgBouncer.
DIRECT_URL=
# Long random string used to sign JWTs.
JWT_SECRET=
PORT=4000
# Origin of the Vite dev server, for CORS.
CLIENT_ORIGIN=http://localhost:5173
