# Neon connection strings go in .env.local, written by `neon env pull`:
#   DATABASE_URL (pooled, used by the server) and DATABASE_URL_UNPOOLED (direct, used by prisma migrate).
# Long random string used to sign JWTs.
JWT_SECRET=
PORT=4000
# Origin of the Vite dev server, for CORS.
CLIENT_ORIGIN=http://localhost:5173
