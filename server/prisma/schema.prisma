generator client {
  // Prisma 7's generator. It writes the client into our project folder
  // (not node_modules), so lib/db.js imports it from there.
  provider     = "prisma-client"
  output       = "../generated/prisma"
}

// The connection URL lives in prisma.config.ts, not here (Prisma 7 rule).
datasource db {
  provider = "postgresql"
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  plants       UserPlant[]
}

// The encyclopedia: one shared row per species, same for every user.
model Plant {
  id                 Int         @id @default(autoincrement())
  name               String
  botanicalName      String
  uses               String      @db.Text
  waterIntervalHours Int
  owners             UserPlant[]
}

// A user's personal copy of a plant. Only the watering time is per-user;
// everything descriptive lives on Plant.
model UserPlant {
  id            Int      @id @default(autoincrement())
  userId        Int
  plantId       Int
  lastWateredAt DateTime
  // Cascade so deleting a user (or plant) doesn't leave orphan garden rows.
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant         Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  // A user owns each plant at most once.
  @@unique([userId, plantId])
}
